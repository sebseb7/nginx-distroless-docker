{
  "name": "nginx-distroless-cli",
  "version": "1.0.0",
  "description": "Node.js React Ink Chalk Vite CLI & interactive TUI manager for distroless Nginx container",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "nginx-cli": "./dist/cli.js"
  },
  "scripts": {
    "dev": "vite-node src/cli.tsx",
    "build": "vite build",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "ink": "^5.0.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-node": "^3.0.0"
  }
}
